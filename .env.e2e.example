# Playwright End-to-End Test Credentials
# Copy this file to .env.e2e (which is git-ignored) and fill in credentials
# for two confirmed Supabase test accounts.

# User A: Primary authenticated test account
E2E_USER_A_EMAIL=test_user_a@example.com
E2E_USER_A_PASSWORD=Password123!

# User B: Secondary account used for multi-user isolation checks
E2E_USER_B_EMAIL=test_user_b@example.com
E2E_USER_B_PASSWORD=Password123!

# User C (Optional): Disposable account for testing real account deletion
E2E_USER_C_EMAIL=test_user_c@example.com
E2E_USER_C_PASSWORD=Password123!
